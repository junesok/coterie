generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  username          String?        @unique  // 로그인에 사용, 영문 소문자+숫자+언더스코어 3~20자
  name              String
  passwordHash      String
  isVerified        Boolean        @default(false)
  isAdmin           Boolean        @default(false)
  theme             String         @default("light")
  avatarUrl         String?        // Cloudinary URL, null이면 기본 아바타
  invitedById       String?
  invitedBy         User?          @relation("InvitedBy", fields: [invitedById], references: [id])
  invitees          User[]         @relation("InvitedBy")
  inviteCodes       InviteCode[]   @relation("Owner")
  usedCode          InviteCode?    @relation("UsedBy")
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  notifications     Notification[] @relation("NotificationReceiver")
  moderationLogs    ModerationLog[]
  createdAt         DateTime       @default(now())
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  owner     User      @relation("Owner", fields: [ownerId], references: [id])
  ownerId   String
  usedBy    User?     @relation("UsedBy", fields: [usedById], references: [id])
  usedById  String?   @unique
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Post {
  id        String         @id @default(cuid())
  content   String
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String
  images    PostImage[]
  comments  Comment[]
  likes     Like[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PostImage {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  order     Int
  createdAt DateTime @default(now())
}

model Comment {
  id        String    @id @default(cuid())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id])
  parentId  String?
  replies   Comment[] @relation("Replies")
  content   String?
  isDeleted Boolean   @default(false)
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Like {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])  // 한 게시물에 한 번만
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  userId    String           // 알림 수신자
  user      User             @relation("NotificationReceiver", fields: [userId], references: [id])
  actorId   String?          // 행동한 유저 (관리자 삭제 시 null 가능)
  postId    String?
  commentId String?
  reason    ModerationReason?  // 관리자 삭제 시 사유
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model ModerationLog {
  id         String           @id @default(cuid())
  targetType ModerationTarget
  targetId   String           // 삭제된 게시물/댓글 ID
  reason     ModerationReason
  adminId    String
  admin      User             @relation(fields: [adminId], references: [id])
  createdAt  DateTime         @default(now())
}

enum ModerationTarget {
  POST
  COMMENT
}

enum ModerationReason {
  SEXUAL_CONTENT
  HATE_SPEECH
  SPAM
  VIOLENCE
  PRIVACY_VIOLATION
  OTHER
}

enum NotificationType {
  COMMENT
  LIKE
  MENTION_POST
  MENTION_COMMENT
  ADMIN_DELETE_POST
  ADMIN_DELETE_COMMENT
}
