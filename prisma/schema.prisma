generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  username          String?        @unique  // 로그인에 사용, 영문 소문자+숫자+언더스코어 3~20자
  name              String
  passwordHash      String
  isVerified        Boolean        @default(false)
  isAdmin           Boolean        @default(false)
  isSuspended       Boolean        @default(false)
  suspendedAt       DateTime?
  suspendedReason   String?
  deletedAt         DateTime?      // 탈퇴 신청 시각 (null = 활성 계정, non-null = 탈퇴 대기)
  theme             String         @default("light")
  avatarUrl         String?        // Cloudinary URL, null이면 기본 아바타
  invitedById       String?
  invitedBy         User?          @relation("InvitedBy", fields: [invitedById], references: [id])
  invitees          User[]         @relation("InvitedBy")
  inviteCodes       InviteCode[]   @relation("Owner")
  usedCode          InviteCode?    @relation("UsedBy")
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  notifications     Notification[] @relation("NotificationReceiver")
  moderationLogs    ModerationLog[]
  reports           Report[]       @relation("ReportSubmitter")
  friendsSent       Friendship[]   @relation("FriendshipSent")
  friendsReceived   Friendship[]   @relation("FriendshipReceived")
  createdAt         DateTime       @default(now())
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  owner     User      @relation("Owner", fields: [ownerId], references: [id])
  ownerId   String
  usedBy    User?     @relation("UsedBy", fields: [usedById], references: [id])
  usedById  String?   @unique
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

// 가입 전 이메일 인증용 임시 테이블 (계정 생성 전)
model TempEmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6자리 숫자 코드
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // 잘못된 코드 입력 횟수 (5회 초과 시 삭제)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Post {
  id         String          @id @default(cuid())
  content    String
  visibility PostVisibility  @default(PUBLIC)
  author     User            @relation(fields: [authorId], references: [id])
  authorId   String
  images     PostImage[]
  comments   Comment[]
  likes      Like[]
  isHidden   Boolean         @default(false)  // 관리자 숨김 (soft delete)
  hiddenAt   DateTime?
  deletedAt  DateTime?       // 사용자 삭제 요청 (soft delete, 신고가 있으면 보존)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

enum PostVisibility {
  PUBLIC
  FRIENDS
}

model PostImage {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  order     Int
  createdAt DateTime @default(now())
}

model Comment {
  id        String    @id @default(cuid())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("Replies")
  content   String?
  isDeleted Boolean   @default(false)
  isEdited  Boolean   @default(false)
  isHidden  Boolean   @default(false)  // 관리자 숨김 (soft delete)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Like {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])  // 한 게시물에 한 번만
}

model Notification {
  id           String           @id @default(cuid())
  type         NotificationType
  userId       String           // 알림 수신자
  user         User             @relation("NotificationReceiver", fields: [userId], references: [id])
  actorId      String?          // 행동한 유저
  postId       String?
  commentId    String?
  friendshipId String?          // 친구 신청 알림용
  reason       ModerationReason?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
}

model ModerationLog {
  id         String            @id @default(cuid())
  targetType ModerationTarget
  targetId   String            // 대상 게시물/댓글/사용자 ID
  action     String            @default("DELETE")  // "HIDE" | "RESTORE" | "DELETE" | "SUSPEND" | "UNSUSPEND"
  reason     ModerationReason?
  adminId    String
  admin      User              @relation(fields: [adminId], references: [id])
  createdAt  DateTime          @default(now())
}

enum ModerationTarget {
  POST
  COMMENT
  USER
}

enum ModerationReason {
  SEXUAL_CONTENT
  HATE_SPEECH
  SPAM
  VIOLENCE
  PRIVACY_VIOLATION
  OTHER
}

enum NotificationType {
  COMMENT
  LIKE
  MENTION_POST
  MENTION_COMMENT
  ADMIN_DELETE_POST
  ADMIN_DELETE_COMMENT
  FRIEND_REQUEST
  FRIEND_ACCEPT
}

model Friendship {
  id         String           @id @default(cuid())
  sender     User             @relation("FriendshipSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  receiver   User             @relation("FriendshipReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Report {
  id          String       @id @default(cuid())
  reporter    User         @relation("ReportSubmitter", fields: [reporterId], references: [id])
  reporterId  String
  targetType  ReportTarget
  targetId    String       // Post.id or Comment.id
  reason      ReportReason
  status      ReportStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedById String?     // adminId
  createdAt   DateTime     @default(now())

  @@unique([reporterId, targetType, targetId]) // 같은 콘텐츠 중복 신고 방지
}

enum ReportTarget {
  POST
  COMMENT
}

enum ReportReason {
  SEXUAL_CONTENT
  HATE_SPEECH
  SPAM
  VIOLENCE
  PRIVACY_VIOLATION
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}
